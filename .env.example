# Copie este arquivo para .env e preencha com sua chave.
# Obtenha a chave em: https://console.groq.com/keys
GROQ_API_KEY=

# --- Opcionais (valores padrão entre parênteses) ---
# Modelo da Groq (openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
# Modelo de embeddings do Hugging Face (intfloat/multilingual-e5-small).
# Ao trocar o modelo, o índice é recriado automaticamente.
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Pastas dos PDFs e do índice vetorial (Documents / chroma_db, relativas ao projeto)
# DOCS_DIR=
# CHROMA_DIR=
